DATABASE_URL="postgresql://huella:huella@localhost:5432/huella?schema=public"
PORT=3000
# Requerida — el server no arranca sin ella (ver apps/api/src/plugins/jwt.ts).
# Secreto HMAC para firmar/verificar los JWT de acceso (@fastify/jwt, HS256).
# Cualquier string no vacío "funciona", pero en producción debe ser un valor
# random de al menos 32 bytes (256 bits): node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-secret-change-me
