{
	"name": "huella-email-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Recurso real de Cloudflare Hyperdrive ("huella-production"),
